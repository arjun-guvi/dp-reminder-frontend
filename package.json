{
  "name": "dp-vc-webapp-frontend",
  "version": "1.0.0",
  "description": "React Frontend Application",
  "main": "src/web/javascripts/index/index.js",
  "scripts": {
    "start": "webpack serve --config ./config/webpack.development.config.js",
    "build:dev": "webpack --config ./config/webpack.development.config.js",
    "build:prod": "env NODE_ENV=production webpack --config ./config/webpack.production.config.js",
    "serve": "node server.js",
    "replit": "npm run build:prod && npm run serve",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "stylelint": "stylelint 'src/**/*.scss' 'src/**/*.css'"
  },
  "dependencies": {
